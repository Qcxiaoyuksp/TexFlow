# 移动云大模型 Token 资源配置 (OpenAI 兼容接口)
ECLOUD_API_KEY=your_ecloud_api_key_here
ECLOUD_BASE_URL=https://your-ecloud-maas-endpoint/v1
ECLOUD_MODEL_NAME=deepseek-v4-flash

# 移动云 MySQL 与 Redis 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=texflow_db
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
